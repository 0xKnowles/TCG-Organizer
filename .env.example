# Card search ---------------------------------------------------------------
# Optional. A pokemontcg.io key (free from dev.pokemontcg.io) used by the
# /api/cards function. Without it that source is unkeyed and TCGdex is the
# fallback either way.
POKEMONTCG_API_KEY=

# Generated binder art ------------------------------------------------------
# One key for both halves: a vision model reads the cards on a page and writes
# the art brief, then an image model renders it.
GEMINI_API_KEY=

# Optional overrides. Google retires model ids from time to time and the error
# names the replacement — set it here rather than waiting on a deploy.
# GEMINI_TEXT_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

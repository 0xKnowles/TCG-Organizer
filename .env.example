# Card search ---------------------------------------------------------------
# Optional. A pokemontcg.io key (free from dev.pokemontcg.io) used by the
# /api/cards function. Without it that source is unkeyed and TCGdex is the
# fallback either way.
POKEMONTCG_API_KEY=

# Generated binder art ------------------------------------------------------
# Claude reads the cards on a page and writes the art brief.
ANTHROPIC_API_KEY=

# The image model that renders the brief. Set one of these; IMAGE_PROVIDER
# picks between them when both are present (gemini | openai).
GEMINI_API_KEY=
OPENAI_API_KEY=
IMAGE_PROVIDER=gemini

# Optional overrides if a provider renames its image model.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1

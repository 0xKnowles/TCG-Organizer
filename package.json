{
  "name": "tcg-binder-organizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plan Pokemon TCG binder pages: pick a binder size, build a card library, and place cards and multi-slot fan art exactly where you want them.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-api-imports.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,md}\"",
    "check:api": "node scripts/check-api-imports.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
